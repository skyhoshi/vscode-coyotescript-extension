{
  "MIDI event": {
    "prefix": "event-midi",
    "body": ["event midi ${1:note} ${2:60}", "    ${0:print ($trigger velocity)}"],
    "description": "Handle a MIDI event."
  },
  "Subscript": {
    "prefix": "script-block",
    "body": ["script ${1:name} ${2|public,hidden,private|}", "    $0"],
    "description": "Declare a named subscript."
  },
  "Conditional": {
    "prefix": "if-block",
    "body": ["if ${1:condition}", "    $0"],
    "description": "Run an indented block conditionally."
  },
  "Loop": {
    "prefix": "repeat-block",
    "body": ["repeat ${1:4}", "    $0"],
    "description": "Repeat an indented block."
  },
  "Translation parameter": {
    "prefix": "translation-parameter",
    "body": ["event uirefreshed", "    translationparameter ${1:input} (textbox \"${2:Label}\" \"${3:Description}\")"],
    "description": "Declare a textbox when CoyoteMIDI refreshes its UI."
  }
}
