{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "wordPattern": "[$%]?[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:if|else|repeat|foreach|while|switch|case|event|script)\\b)[^\\r\\n]*$",
    "decreaseIndentPattern": "^\\s*(?:else|case)\\b"
  },
  "folding": { "offSide": true }
}
